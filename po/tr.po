msgid "Command line"
msgstr "Komut satırı"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q pencereyi kapatır (:q! sekmeleri sormadan), :qa Beluga'dan çıkar, :e veya :cd YOL bir klasör açar, :tabnew [YOL], :tabclose, :tabonly, :sp veya :vs [YOL] görünümü böler, :only diğer görünümü kapatır, :mkdir AD, :touch AD, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!KOMUT klasörde bir kabuk komutu çalıştırır."


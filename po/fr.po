msgid "Vim notation, several separated by spaces: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Leave a field empty for the default."
msgstr "Notation Vim, plusieurs séparées par des espaces : h, gg, <C-v>, <CR>, <Esc>, <leader>t. Laissez un champ vide pour la valeur par défaut."

msgid "Command line"
msgstr "Ligne de commande"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q ferme la fenêtre (:q! sans demander pour ses onglets), :qa quitte Beluga, :e / :cd CHEMIN ouvre un dossier, :tabnew [CHEMIN], :tabclose, :tabonly, :sp / :vs [CHEMIN] scindent la vue, :only ferme l'autre vue, :mkdir NOM, :touch NOM, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMANDE exécute une commande shell dans le dossier."


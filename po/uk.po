msgstr "Позначити елементи, якими проходить курсор (візуальний)"

msgid "Select a range, like Shift (visual line)"
msgstr "Позначити діапазон, як із Shift (візуальний рядок)"

msgid "Select a block of the grid (visual block)"
msgstr "Позначити блок сітки (візуальний блок)"

msgid "Back to normal mode"
msgstr "Повернутися до звичайного режиму"

msgid "Copy the item under the cursor"
msgstr "Копіювати елемент під курсором"

msgid "Rename, cursor at the start (insert)"
msgstr "Перейменувати, курсор на початку (вставка)"

msgid "Rename, cursor after the name (append)"
msgstr "Перейменувати, курсор після назви (додавання)"

msgid "Rename, name selected (change)"
msgstr "Перейменувати, назву позначено (заміна)"

msgid "Edit the location"
msgstr "Змінити розташування"

msgid "Copied."
msgstr "Скопійовано."

msgid "Cut."
msgstr "Вирізано."

#, c-format
msgid "Can't open “%s”."
msgstr "Не вдалося відкрити «%s»."

msgid "A name is needed."
msgstr "Потрібна назва."

#, c-format
msgid "Unknown view: %s"
msgstr "Невідомий перегляд: %s"

#, c-format
msgid "Unknown option: %s"
msgstr "Невідомий параметр: %s"

msgid "Sort by name, size, date or type."
msgstr "Упорядкувати за name, size, date або type."

#, c-format
msgid "Not a command: %s"
msgstr "Не команда: %s"

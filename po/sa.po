msgid "Select the items the cursor passes (visual)"
msgstr "सूचकः यानि वस्तूनि अतिक्रामति तानि चिनोतु (दृश्यम्)"

msgid "Select a range, like Shift (visual line)"
msgstr "Shift इव परिधिं चिनोतु (दृश्यपङ्क्तिः)"

msgid "Select a block of the grid (visual block)"
msgstr "जालकात् खण्डं चिनोतु (दृश्यखण्डः)"

msgid "Back to normal mode"
msgstr "सामान्यविधिं प्रति प्रत्यागच्छतु"

msgid "Copy the item under the cursor"
msgstr "सूचकस्य अधः स्थितं वस्तु प्रतिलिपतु"

msgid "Rename, cursor at the start (insert)"
msgstr "नामान्तरम्, सूचकः आदौ (निवेशः)"

msgid "Rename, cursor after the name (append)"
msgstr "नामान्तरम्, सूचकः नाम्नः परम् (योजनम्)"

msgid "Rename, name selected (change)"
msgstr "नामान्तरम्, नाम चितम् (परिवर्तनम्)"

msgid "Edit the location"
msgstr "स्थानं सम्पादयतु"

msgid "Copied."
msgstr "प्रतिलिपितम्।"

msgid "Cut."
msgstr "कर्तितम्।"

#, c-format
msgid "Can't open “%s”."
msgstr "“%s” उद्घाटयितुं न शक्यते।"

msgid "A name is needed."
msgstr "नाम आवश्यकम्।"

#, c-format
msgid "Unknown view: %s"
msgstr "अज्ञातं दृश्यम्: %s"

#, c-format
msgid "Unknown option: %s"
msgstr "अज्ञातः विकल्पः: %s"

msgid "Sort by name, size, date or type."
msgstr "name, size, date अथवा type द्वारा क्रमयतु।"

#, c-format
msgid "Not a command: %s"
msgstr "आदेशः नास्ति: %s"

#, c-format
msgid "Renaming “%s” to “%s” changes its extension. The file may open with a different application or not at all."
msgstr "ການປ່ຽນຊື່ “%s” ເປັນ “%s” ຈະປ່ຽນນາມສະກຸນຂອງມັນ. ໄຟລ໌ອາດເປີດດ້ວຍແອັບພລິເຄຊັນອື່ນ ຫຼື ບໍ່ເປີດເລີຍ."

msgid "Selection Mode: click files or folders to select or deselect them."
msgstr "ໂໝດເລືອກ: ຄລິກໄຟລ໌ ຫຼື ໂຟນເດີເພື່ອເລືອກ ຫຼື ຍົກເລີກການເລືອກ."

msgid "_Exit Selection Mode"
msgstr "ອອກຈາກໂໝດເລືອກ (_E)"

msgid "_Duplicate"
msgstr "ສຳເນົາຊ້ຳ (_D)"

msgid "De_lete"
msgstr "ລຶບ (_L)"

msgid "Pr_operties"
msgstr "ຄຸນສົມບັດ (_O)"

#, c-format
msgid "The folder “%s” no longer exists."
msgstr "ໂຟນເດີ “%s” ບໍ່ມີຢູ່ອີກແລ້ວ."

#, c-format
msgid "“%s” selected (%s%s)"
msgstr "ເລືອກ “%s” (%s%s)"

#, c-format
msgid "%s selected"
msgstr "ເລືອກ %s"

msgid "Loading folder…"
msgstr "ກຳລັງໂຫຼດໂຟນເດີ…"

#, c-format
msgid "%d selected"
msgid_plural "%d selected"
msgstr[0] "ເລືອກ %d"

msgid "Move left"
msgstr "ຊ້າຍ"

msgid "Move down"
msgstr "ລົງ"

msgid "Move up"
msgstr "ຂຶ້ນ"

msgid "Move right"
msgstr "ຂວາ"

msgid "First item"
msgstr "ລາຍການທຳອິດ"

msgid "Last item"
msgstr "ລາຍການສຸດທ້າຍ"

msgid "Page down"
msgstr "ໜ້າລົງ"

msgid "Page up"
msgstr "ໜ້າຂຶ້ນ"

msgid "Parent folder"
msgstr "ໂຟນເດີແມ່"

msgid "Select the items the cursor passes (visual)"
msgstr "ເລືອກລາຍການທີ່ເຄີເຊີຜ່ານ (ພາບ)"

msgid "Select a range, like Shift (visual line)"
msgstr "ເລືອກຊ່ວງ ຄືກັບ Shift (ແຖວພາບ)"

msgid "Select a block of the grid (visual block)"
msgstr "ເລືອກບລັອກຈາກຕາຕະລາງ (ບລັອກພາບ)"

msgid "Back to normal mode"
msgstr "ກັບໄປໂໝດປົກກະຕິ"

msgid "Copy the item under the cursor"
msgstr "ສຳເນົາລາຍການທີ່ຢູ່ໃຕ້ເຄີເຊີ"

msgid "Rename, cursor at the start (insert)"
msgstr "ປ່ຽນຊື່, ເຄີເຊີຢູ່ຕົ້ນ (ແຊກ)"

msgid "Rename, cursor after the name (append)"
msgstr "ປ່ຽນຊື່, ເຄີເຊີຫຼັງຊື່ (ຕໍ່ທ້າຍ)"

msgid "Rename, name selected (change)"
msgstr "ປ່ຽນຊື່, ເລືອກຊື່ໄວ້ (ປ່ຽນ)"

msgid "Edit the location"
msgstr "ແກ້ໄຂບ່ອນ"

msgid "Copied."
msgstr "ສຳເນົາແລ້ວ."

msgid "Cut."
msgstr "ຕັດແລ້ວ."

#, c-format
msgid "Can't open “%s”."
msgstr "ບໍ່ສາມາດເປີດ “%s” ໄດ້."

msgid "A name is needed."
msgstr "ຕ້ອງມີຊື່."

#, c-format
msgid "Unknown view: %s"
msgstr "ມຸມມອງທີ່ບໍ່ຮູ້ຈັກ: %s"

#, c-format
msgid "Unknown option: %s"
msgstr "ຕົວເລືອກທີ່ບໍ່ຮູ້ຈັກ: %s"

msgid "Sort by name, size, date or type."
msgstr "ຮຽງຕາມ name, size, date ຫຼື type."

#, c-format
msgid "Not a command: %s"
msgstr "ບໍ່ແມ່ນຄຳສັ່ງ: %s"

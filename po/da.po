msgid "Vim notation, several separated by spaces: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Leave a field empty for the default."
msgstr "Vim-notation, flere adskilt med mellemrum: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Lad et felt være tomt for standarden."

msgid "Command line"
msgstr "Kommandolinje"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q lukker vinduet (:q! uden at spørge om fanebladene), :qa afslutter Beluga, :e eller :cd STI åbner en mappe, :tabnew [STI], :tabclose, :tabonly, :sp eller :vs [STI] deler visningen, :only lukker den anden visning, :mkdir NAVN, :touch NAVN, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!KOMMANDO kører en skalkommando i mappen."


msgid "Command line"
msgstr "Ukazna vrstica"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q zapre okno (:q! brez vprašanja o zavihkih), :qa konča Belugo, :e ali :cd POT odpre mapo, :tabnew [POT], :tabclose, :tabonly, :sp ali :vs [POT] razdelita pogled, :only zapre drugi pogled, :mkdir IME, :touch IME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!UKAZ zažene ukaz lupine v mapi."


msgid "'Copy To' and 'Move To'"
msgstr "'ສຳເນົາໄປ' ແລະ 'ຍ້າຍໄປ'"

msgid "Delete (in addition to Move to Trash)"
msgstr "ລຶບ (ນອກຈາກຍ້າຍໄປຖັງຂີ້ເຫຍື້ອ)"

msgid "Cleanup:"
msgstr "ການທຳຄວາມສະອາດ:"

msgid "Delete files older than"
msgstr "ລຶບໄຟລ໌ທີ່ເກົ່າກວ່າ"

msgid "days"
msgstr "ມື້"

msgid "Limit to"
msgstr "ຈຳກັດທີ່"

msgid "percent of the disk"
msgstr "ເປີເຊັນຂອງດິສກ໌"


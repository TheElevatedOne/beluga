msgstr "இன்னும் எண்ணப்படவில்லை"

msgid "A file name cannot contain “/”."
msgstr "கோப்புப் பெயரில் “/” இருக்கக் கூடாது."

msgid "Renaming “%s” to “%s” changes its extension. The file may open with a different application or not at all."
msgstr "“%s” ஐ “%s” எனப் பெயர்மாற்றுவது அதன் நீட்டிப்பை மாற்றும். கோப்பு வேறு பயன்பாட்டில் திறக்கலாம் அல்லது திறக்காமலே போகலாம்."

msgid "Selection Mode: click files or folders to select or deselect them."
msgstr "தேர்வுப் பயன்முறை: கோப்புகள் அல்லது அடைவுகளைத் தேர்ந்தெடுக்க அல்லது தேர்வுநீக்க அவற்றைச் சொடுக்கவும்."

msgid "_Exit Selection Mode"
msgstr "தேர்வுப் பயன்முறையிலிருந்து வெளியேறு (_E)"

msgid "_Duplicate"
msgstr "நகல் உருவாக்கு (_D)"

msgid "De_lete"
msgstr "நீக்கு (_L)"

msgid "Pr_operties"
msgstr "பண்புகள் (_O)"

msgid "The folder “%s” no longer exists."
msgstr "“%s” அடைவு இனி இல்லை."

msgid "“%s” selected (%s%s)"
msgstr "“%s” தேர்ந்தெடுக்கப்பட்டது (%s%s)"

msgid "%s selected"
msgstr "%s தேர்ந்தெடுக்கப்பட்டன"

msgid "%d selected"
msgid_plural "%d selected"
msgstr[0] "%d தேர்ந்தெடுக்கப்பட்டது"
msgstr[1] "%d தேர்ந்தெடுக்கப்பட்டன"

msgid "Move left"
msgstr "இடப்புறம்"

msgid "Move down"
msgstr "கீழே"

msgid "Move up"
msgstr "மேலே"

msgid "Move right"
msgstr "வலப்புறம்"

msgid "First item"
msgstr "முதல் உருப்படி"

msgid "Last item"
msgstr "கடைசி உருப்படி"

msgid "Page down"
msgstr "பக்கம் கீழே"

msgid "Page up"
msgstr "பக்கம் மேலே"

msgid "Select the items the cursor passes (visual)"
msgstr "சுட்டி கடந்து செல்லும் உருப்படிகளைத் தேர்ந்தெடு (காட்சி)"

msgid "Select a range, like Shift (visual line)"
msgstr "Shift போல ஒரு வரம்பைத் தேர்ந்தெடு (காட்சி வரி)"

msgid "Select a block of the grid (visual block)"
msgstr "கட்டத்திலிருந்து ஒரு தொகுதியைத் தேர்ந்தெடு (காட்சித் தொகுதி)"

msgid "Back to normal mode"
msgstr "இயல்புப் பயன்முறைக்குத் திரும்பு"

msgid "Copy the item under the cursor"
msgstr "சுட்டியின் கீழுள்ள உருப்படியை நகலெடு"

msgid "Rename, cursor at the start (insert)"
msgstr "பெயர்மாற்று, சுட்டி தொடக்கத்தில் (செருகு)"

msgid "Rename, cursor after the name (append)"
msgstr "பெயர்மாற்று, சுட்டி பெயருக்குப் பின் (இணை)"

msgid "Rename, name selected (change)"
msgstr "பெயர்மாற்று, பெயர் தேர்ந்தெடுக்கப்பட்டது (மாற்று)"

msgid "Edit the location"
msgstr "இருப்பிடத்தைத் திருத்து"

msgid "Copied."
msgstr "நகலெடுக்கப்பட்டது."

msgid "Cut."
msgstr "வெட்டப்பட்டது."

msgid "Can't open “%s”."
msgstr "“%s” ஐத் திறக்க முடியாது."

msgid "A name is needed."
msgstr "ஒரு பெயர் தேவை."

msgid "Unknown view: %s"
msgstr "அறியாத காட்சி: %s"

msgid "Unknown option: %s"
msgstr "அறியாத விருப்பம்: %s"

msgid "Sort by name, size, date or type."
msgstr "name, size, date அல்லது type மூலம் வரிசைப்படுத்தவும்."

msgid "Not a command: %s"
msgstr "கட்டளை அல்ல: %s"

msgid "Move"
msgstr "நகர்த்து"

msgid "Split View to Tabs"
msgstr "பிரிந்த காட்சியைத் தாவல்களாக"

msgid "Folders Panel"
msgstr "அடைவுகள் பலகம்"

msgid "Columns"
msgstr "நெடுவரிசைகள்"

msgid "Folders Panel:"
msgstr "அடைவுகள் பலகம்:"

msgid "Limit to home directory when inside it"
msgstr "இல்ல அடைவினுள் இருக்கும்போது அதற்கே வரம்பிடு"

msgid "Spacing:"
msgstr "இடைவெளி:"

msgid "%s free of %s (%d%% used)"
msgstr "%2$s இல் %1$s காலி (%3$d%% பயன்பாட்டில்)"

msgid "Add Network Location…"
msgstr "வலையமைப்பு இடத்தைச் சேர்…"

msgid "Add Network Location"
msgstr "வலையமைப்பு இடத்தைச் சேர்"

msgid "Windows share (SMB)"
msgstr "விண்டோஸ் பகிர்வு (SMB)"

msgid "Secure WebDAV"
msgstr "பாதுகாப்பான WebDAV"

msgid "Server:"
msgstr "சேவையகம்:"

msgid "Port:"
msgstr "துறை:"

msgid "FTP over TLS (explicit)"
msgstr "TLS வழியாக FTP (வெளிப்படை)"

msgid "FTP over TLS (implicit)"
msgstr "TLS வழியாக FTP (மறைமுக)"

msgid "Normal"
msgstr "இயல்பு"

msgid "Ask for password"
msgstr "கடவுச்சொல்லைக் கேள்"

msgid "Key file"
msgstr "சாவிக் கோப்பு"

msgid "Protocol:"
msgstr "நெறிமுறை:"

msgid "Host:"
msgstr "புரவலர்:"

msgid "Logon type:"
msgstr "உள்நுழைவு வகை:"

msgid "Key file:"
msgstr "சாவிக் கோப்பு:"

msgid "Type or paste an address to fill in the fields above."
msgstr "மேலுள்ள புலங்களை நிரப்ப முகவரியைத் தட்டச்சு செய்யவும் அல்லது ஒட்டவும்."

msgid "The SFTP connection uses ssh's settings, so Beluga adds a Host entry for this key to ~/.ssh/config."
msgstr "SFTP இணைப்பு ssh-இன் அமைப்புகளைப் பயன்படுத்துவதால், Beluga இந்தச் சாவிக்கு ~/.ssh/config-இல் ஒரு Host பதிவைச் சேர்க்கிறது."

msgid "Choose a Key File"
msgstr "சாவிக் கோப்பைத் தேர்ந்தெடு"

msgid "Could not add the key to ~/.ssh/config."
msgstr "சாவியை ~/.ssh/config-இல் சேர்க்க முடியவில்லை."

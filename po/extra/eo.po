msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q fermas la fenestron (:q! sen demandi pri ĝiaj langetoj), :qa ĉesigas Beluga, :e aŭ :cd VOJO malfermas dosierujon, :tabnew [VOJO], :tabclose, :tabonly, :sp aŭ :vs [VOJO] dividas la vidon, :only fermas la alian vidon, :mkdir NOMO, :touch NOMO, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!KOMANDO rulas ŝelan komandon en la dosierujo."


msgstr "Notation de Vim, plure separate per spatios: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Lassa un campo vacue pro le predefinite."

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q claude le fenestra (:q! sin demandar re su schedas), :qa quita Beluga, :e o :cd PERCURSO aperi un dossier, :tabnew [PERCURSO], :tabclose, :tabonly, :sp o :vs [PERCURSO] divide le vista, :only claude le altere vista, :mkdir NOMINE, :touch NOMINE, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMANDO executa un commando de shell in le dossier."


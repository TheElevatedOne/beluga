msgid "Command line"
msgstr "Opdrachtregel"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q sluit het venster (:q! zonder te vragen naar de tabbladen), :qa sluit Beluga af, :e / :cd PAD opent een map, :tabnew [PAD], :tabclose, :tabonly, :sp / :vs [PAD] splitsen de weergave, :only sluit de andere weergave, :mkdir NAAM, :touch NAAM, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!OPDRACHT voert een shell-opdracht uit in de map."


msgid "Vim notation, several separated by spaces: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Leave a field empty for the default."
msgstr "Vim-Schreibweise, mehrere durch Leerzeichen getrennt: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Ein leeres Feld verwendet die Voreinstellung."

msgid "Command line"
msgstr "Befehlszeile"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q schließt das Fenster (:q! ohne Nachfrage zu den Unterfenstern), :qa beendet Beluga, :e / :cd PFAD öffnet einen Ordner, :tabnew [PFAD], :tabclose, :tabonly, :sp / :vs [PFAD] teilt die Ansicht, :only schließt die andere Ansicht, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!BEFEHL führt einen Shell-Befehl im Ordner aus."


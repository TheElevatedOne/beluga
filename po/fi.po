msgid "Vim notation, several separated by spaces: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Leave a field empty for the default."
msgstr "Vim-merkintätapa, useita välilyönnein erotettuina: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Jätä kenttä tyhjäksi käyttääksesi oletusta."

msgid "Command line"
msgstr "Komentorivi"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q sulkee ikkunan (:q! kysymättä välilehdistä), :qa lopettaa Belugan, :e tai :cd POLKU avaa kansion, :tabnew [POLKU], :tabclose, :tabonly, :sp tai :vs [POLKU] jakavat näkymän, :only sulkee toisen näkymän, :mkdir NIMI, :touch NIMI, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!KOMENTO suorittaa kuorikomennon kansiossa."


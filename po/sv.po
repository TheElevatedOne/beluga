msgid "Normal mode moves with h j k l and runs the keys below; v, V and Ctrl+V select; i and a rename (insert mode); Esc goes back to normal mode; : opens the command line. Keys with Ctrl or Alt that aren't listed here keep their usual meaning."
msgstr "Normalläget flyttar med h j k l och kör tangenterna nedan; v, V och Ctrl+V markerar; i och a byter namn (infogningsläge); Esc går tillbaka till normalläget; : öppnar kommandoraden. Tangenter med Ctrl eller Alt som inte finns här behåller sin vanliga betydelse."

msgid "Leader key:"
msgstr "Ledartangent:"

msgid "<leader> in the keys below, e.g. <Space> or ,"
msgstr "<leader> i tangenterna nedan, t.ex. <Space> eller ,"

msgid "Wait for more keys:"
msgstr "Vänta på fler tangenter:"

msgid "ms (dd after d, gg after g)"
msgstr "ms (dd efter d, gg efter g)"

msgid "Keys"
msgstr "Tangenter"

msgid "Vim notation, several separated by spaces: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Leave a field empty for the default."
msgstr "Vim-notation, flera åtskilda med mellanslag: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Lämna ett fält tomt för standardvärdet."

msgid "Command line"
msgstr "Kommandorad"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q stänger fönstret (:q! utan att fråga om dess flikar), :qa avslutar Beluga, :e eller :cd SÖKVÄG öppnar en mapp, :tabnew [SÖKVÄG], :tabclose, :tabonly, :sp eller :vs [SÖKVÄG] delar vyn, :only stänger den andra vyn, :mkdir NAMN, :touch NAMN, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!KOMMANDO kör ett skalkommando i mappen."


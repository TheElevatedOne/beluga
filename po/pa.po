msgstr "ਚੋਣ ਮੋਡ: ਫ਼ਾਈਲਾਂ ਜਾਂ ਫ਼ੋਲਡਰਾਂ ਨੂੰ ਚੁਣਨ ਜਾਂ ਚੋਣ ਹਟਾਉਣ ਲਈ ਉਨ੍ਹਾਂ ’ਤੇ ਕਲਿੱਕ ਕਰੋ।"

msgid "_Exit Selection Mode"
msgstr "ਚੋਣ ਮੋਡ ਤੋਂ ਬਾਹਰ ਜਾਓ (_E)"

msgid "_Duplicate"
msgstr "ਨਕਲ ਬਣਾਓ (_D)"

msgid "De_lete"
msgstr "ਹਟਾਓ (_L)"

msgid "Pr_operties"
msgstr "ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ (_O)"

#, c-format
msgid "The folder “%s” no longer exists."
msgstr "ਫ਼ੋਲਡਰ “%s” ਹੁਣ ਮੌਜੂਦ ਨਹੀਂ ਹੈ।"

#, c-format
msgid "“%s” selected (%s%s)"
msgstr "“%s” ਚੁਣਿਆ (%s%s)"

#, c-format
msgid "%s selected"
msgstr "%s ਚੁਣੇ"

msgid "Loading folder…"
msgstr "ਫੋਲਡਰ ਲੋਡ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ…"

#, c-format
msgid "%d selected"
msgid_plural "%d selected"
msgstr[0] "%d ਚੁਣਿਆ"
msgstr[1] "%d ਚੁਣੇ"

msgid "Move left"
msgstr "ਖੱਬੇ"

msgid "Move down"
msgstr "ਹੇਠਾਂ"

msgid "Move up"
msgstr "ਉੱਪਰ"

msgid "Move right"
msgstr "ਸੱਜੇ"

msgid "First item"
msgstr "ਪਹਿਲੀ ਆਈਟਮ"

msgid "Last item"
msgstr "ਆਖਰੀ ਆਈਟਮ"

msgid "Page down"
msgstr "ਸਫ਼ਾ ਹੇਠਾਂ"

msgid "Page up"
msgstr "ਸਫ਼ਾ ਉੱਪਰ"

msgid "Parent folder"
msgstr "ਮੁੱਢਲਾ ਫੋਲਡਰ"

msgid "Select the items the cursor passes (visual)"
msgstr "ਕਰਸਰ ਜਿਨ੍ਹਾਂ ਆਈਟਮਾਂ ਤੋਂ ਲੰਘਦਾ ਹੈ ਉਹ ਚੁਣੋ (ਦ੍ਰਿਸ਼)"

msgid "Select a range, like Shift (visual line)"
msgstr "Shift ਵਾਂਗ ਇੱਕ ਰੇਂਜ ਚੁਣੋ (ਦ੍ਰਿਸ਼ ਲਾਈਨ)"

msgid "Select a block of the grid (visual block)"
msgstr "ਗਰਿੱਡ ਤੋਂ ਇੱਕ ਬਲਾਕ ਚੁਣੋ (ਦ੍ਰਿਸ਼ ਬਲਾਕ)"

msgid "Back to normal mode"
msgstr "ਆਮ ਮੋਡ ਵਿੱਚ ਵਾਪਸ ਜਾਓ"

msgid "Copy the item under the cursor"
msgstr "ਕਰਸਰ ਹੇਠਲੀ ਆਈਟਮ ਕਾਪੀ ਕਰੋ"

msgid "Rename, cursor at the start (insert)"
msgstr "ਨਾਂ ਬਦਲੋ, ਕਰਸਰ ਸ਼ੁਰੂ ਵਿੱਚ (ਪਾਓ)"

msgid "Rename, cursor after the name (append)"
msgstr "ਨਾਂ ਬਦਲੋ, ਕਰਸਰ ਨਾਂ ਤੋਂ ਬਾਅਦ (ਜੋੜੋ)"

msgid "Rename, name selected (change)"
msgstr "ਨਾਂ ਬਦਲੋ, ਨਾਂ ਚੁਣਿਆ (ਬਦਲੋ)"

msgid "Edit the location"
msgstr "ਟਿਕਾਣਾ ਸੋਧੋ"

msgid "Copied."
msgstr "ਕਾਪੀ ਕੀਤਾ।"

msgid "Cut."
msgstr "ਕੱਟਿਆ।"

#, c-format
msgid "Can't open “%s”."
msgstr "“%s” ਖੋਲ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।"

msgid "A name is needed."
msgstr "ਨਾਂ ਲੋੜੀਂਦਾ ਹੈ।"

#, c-format
msgid "Unknown view: %s"
msgstr "ਅਣਜਾਣ ਝਲਕ: %s"

#, c-format
msgid "Unknown option: %s"
msgstr "ਅਣਜਾਣ ਚੋਣ: %s"

msgid "Sort by name, size, date or type."
msgstr "name, size, date ਜਾਂ type ਨਾਲ ਲੜੀਬੱਧ ਕਰੋ।"

#, c-format
msgid "Not a command: %s"
msgstr "ਕਮਾਂਡ ਨਹੀਂ: %s"

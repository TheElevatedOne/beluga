msgid "Use Vim-like keys in the views"
msgstr "Kasuta vaadetes Vimi-laadseid klahve"

msgid "Normal mode moves with h j k l and runs the keys below; v, V and Ctrl+V select; i and a rename (insert mode); Esc goes back to normal mode; : opens the command line. Keys with Ctrl or Alt that aren't listed here keep their usual meaning."
msgstr "Tavarežiim liigub klahvidega h j k l ja täidab allolevaid klahve; v, V ja Ctrl+V valivad; i ja a nimetavad ümber (sisestusrežiim); Esc naaseb tavarežiimi; : avab käsurea. Ctrl- või Alt-klahvid, mida siin pole, säilitavad tavapärase tähenduse."

msgid "Leader key:"
msgstr "Juhtklahv:"

msgid "<leader> in the keys below, e.g. <Space> or ,"
msgstr "<leader> allolevates klahvides, nt <Space> või ,"

msgid "Wait for more keys:"
msgstr "Oota lisaklahve:"

msgid "ms (dd after d, gg after g)"
msgstr "ms (dd pärast d-d, gg pärast g-d)"

msgid "Keys"
msgstr "Klahvid"

msgid "Vim notation, several separated by spaces: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Leave a field empty for the default."
msgstr "Vimi tähistus, mitu tühikuga eraldatult: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Vaikeväärtuse jaoks jätke väli tühjaks."

msgid "Command line"
msgstr "Käsurida"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q sulgeb akna (:q! kaartide kohta küsimata), :qa väljub Belugast, :e või :cd ASUKOHT avab kausta, :tabnew [ASUKOHT], :tabclose, :tabonly, :sp või :vs [ASUKOHT] poolitavad vaate, :only sulgeb teise vaate, :mkdir NIMI, :touch NIMI, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!KÄSK käivitab kaustas shellikäsu."


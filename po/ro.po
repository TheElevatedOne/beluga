msgid "Command line"
msgstr "Linie de comandă"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q închide fereastra (:q! fără să întrebe de file), :qa iese din Beluga, :e sau :cd CALE deschide un dosar, :tabnew [CALE], :tabclose, :tabonly, :sp sau :vs [CALE] divizează vizualizarea, :only închide cealaltă vizualizare, :mkdir NUME, :touch NUME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMANDĂ rulează o comandă shell în dosar."


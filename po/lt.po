msgid "Command line"
msgstr "Komandų eilutė"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q užveria langą (:q! neklausiant apie korteles), :qa išeina iš Beluga, :e arba :cd KELIAS atveria aplanką, :tabnew [KELIAS], :tabclose, :tabonly, :sp arba :vs [KELIAS] padalija rodinį, :only užveria kitą rodinį, :mkdir PAVADINIMAS, :touch PAVADINIMAS, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!KOMANDA vykdo apvalkalo komandą aplanke."


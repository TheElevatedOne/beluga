msgid "Vim notation, several separated by spaces: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Leave a field empty for the default."
msgstr "Vim-ritháttur, nokkrir aðskildir með bilum: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Skildu reit eftir auðan fyrir sjálfgefið."

msgid "Command line"
msgstr "Skipanalína"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q lokar glugganum (:q! án þess að spyrja um flipana), :qa hættir í Beluga, :e eða :cd SLÓÐ opnar möppu, :tabnew [SLÓÐ], :tabclose, :tabonly, :sp eða :vs [SLÓÐ] skipta sýninni, :only lokar hinni sýninni, :mkdir HEITI, :touch HEITI, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!SKIPUN keyrir skeljarskipun í möppunni."


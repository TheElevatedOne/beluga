msgid "Rename, cursor after the name (append)"
msgstr "이름 바꾸기, 커서를 이름 뒤에(추가)"

msgid "Rename, name selected (change)"
msgstr "이름 바꾸기, 이름 선택됨(변경)"

msgid "Edit the location"
msgstr "위치 편집"

msgid "Copied."
msgstr "복사했습니다."

msgid "Cut."
msgstr "잘라냈습니다."

#, c-format
msgid "Can't open “%s”."
msgstr "“%s”을(를) 열 수 없습니다."

msgid "A name is needed."
msgstr "이름이 필요합니다."

#, c-format
msgid "Unknown view: %s"
msgstr "알 수 없는 보기: %s"

#, c-format
msgid "Unknown option: %s"
msgstr "알 수 없는 옵션: %s"

msgid "Sort by name, size, date or type."
msgstr "이름, 크기, 날짜 또는 형식으로 정렬하십시오."

#, c-format
msgid "Not a command: %s"
msgstr "명령이 아님: %s"

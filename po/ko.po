msgstr "목록에서 위치 표시줄보다 위에 있는 동작은 그 왼쪽에, 나머지는 오른쪽에 놓입니다. *는 기본 도구 모음의 위치에 있지 않은 동작을 표시합니다."

msgid "A_vailable actions:"
msgstr "사용 가능한 동작(_V):"

msgid "Add to the tool bar"
msgstr "도구 모음에 추가"

msgid "Remove from the tool bar"
msgstr "도구 모음에서 제거"

msgid "Move up (left on the tool bar)"
msgstr "위로 이동(도구 모음에서 왼쪽)"

msgid "Move down (right on the tool bar)"
msgstr "아래로 이동(도구 모음에서 오른쪽)"

msgid "C_urrent actions:"
msgstr "현재 동작(_U):"

msgid "_Defaults"
msgstr "기본값(_D)"

msgid "Show Columns"

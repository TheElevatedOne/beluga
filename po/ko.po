msgstr "폴더가 비어 있음"

msgid "A file name cannot contain “/”."
msgstr "파일 이름에 “/”를 포함할 수 없습니다."

#, c-format
msgid "Renaming “%s” to “%s” changes its extension. The file may open with a different application or not at all."
msgstr "“%s”을(를) “%s”(으)로 이름을 바꾸면 확장자가 바뀝니다. 파일이 다른 프로그램으로 열리거나 아예 열리지 않을 수 있습니다."

msgid "Selection Mode: click files or folders to select or deselect them."
msgstr "선택 모드: 파일이나 폴더를 클릭하여 선택하거나 선택 해제하십시오."

msgid "_Exit Selection Mode"
msgstr "선택 모드 끝내기(_E)"

msgid "_Duplicate"
msgstr "복제(_D)"

msgid "De_lete"
msgstr "삭제(_L)"

msgid "Pr_operties"
msgstr "속성(_O)"

#, c-format
msgid "The folder “%s” no longer exists."
msgstr "“%s” 폴더가 더 이상 없습니다."

#, c-format
msgid "“%s” selected (%s%s)"
msgstr "“%s” 선택됨 (%s%s)"

#, c-format

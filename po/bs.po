msgstr "Tipke"

msgid "Vim notation, several separated by spaces: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Leave a field empty for the default."
msgstr "Vim zapis, više njih odvojenih razmakom: h, gg, <C-v>, <CR>, <Esc>, <leader>t. Ostavite polje prazno za zadano."

msgid "Command line"
msgstr "Komandna linija"

msgid ":q closes the window (:q! without asking about its tabs), :qa quits Beluga, :e or :cd PATH opens a folder, :tabnew [PATH], :tabclose, :tabonly, :sp or :vs [PATH] split the view, :only closes the other view, :mkdir NAME, :touch NAME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!COMMAND runs a shell command in the folder."
msgstr ":q zatvara prozor (:q! bez pitanja o karticama), :qa izlazi iz Beluge, :e ili :cd PUTANJA otvara mapu, :tabnew [PUTANJA], :tabclose, :tabonly, :sp ili :vs [PUTANJA] dijele prikaz, :only zatvara drugi prikaz, :mkdir IME, :touch IME, :set hidden / nohidden / hidden!, :set view=icons|compact|details|columns, :sort name|size|date|type, :pwd, :term, :du, :help, :!NAREDBA izvršava naredbu ljuske u mapi."


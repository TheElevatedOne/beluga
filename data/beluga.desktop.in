[Desktop Entry]
Type=Application
Name=Beluga
GenericName=File Manager
Comment=Browse and manage files and folders
Exec=@CMAKE_INSTALL_FULL_BINDIR@/beluga %U
Icon=@BELUGA_APP_ID@
Terminal=false
StartupNotify=true
DBusActivatable=false
Categories=GTK;System;FileTools;FileManager;
Keywords=files;folders;browse;explorer;manager;
MimeType=inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@CMAKE_INSTALL_FULL_BINDIR@/beluga --new-window
